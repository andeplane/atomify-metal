# ZSM-5 (MFI) zeolite: silicon (type 1) and oxygen (type 2), Vashishta SiO2.
# 2 x 2 x 2 unit cells. The cell is rotated (rotate-channels.py) so the straight
# 10-ring channels run along z, toward the viewer; the atoms are shifted half a
# cell in x so one straight channel runs through the middle of the box.
#/atom 1 silicon
#/atom 2 oxygen
#/bond 1 2 2.6

units metal
atom_style	atomic

read_data zeolite_zsm5_channels_z.data
replicate 2 2 2
displace_atoms all move 10.045 0 0 units box

pair_style	vashishta
pair_coeff	* * SiO2.vashishta Si O
neigh_modify every 1 delay 0 check yes

mass 1 28.08
mass 2 15.9994

# Half the kinetic energy flows into vibrations, so start at twice 300 K.
velocity all create 600 376847 loop geom mom yes rot yes
fix nvt all nvt temp 300 300 0.5

timestep 0.002

thermo_style one
thermo 1000

run 2000
