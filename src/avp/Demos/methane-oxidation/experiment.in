# Research candidate: compressed methane/oxygen with the published CHO ReaxFF.
# Reaction timing and temperatures are model dependent; not an ambient flame.
#/atom 1 carbon
#/atom 2 hydrogen
#/atom 3 oxygen
#/bond 1 1 1.85
#/bond 1 2 1.35
#/bond 1 3 1.75
#/bond 2 2 0.95
#/bond 2 3 1.20
#/bond 3 3 1.50
units real
atom_style charge
boundary p p p
read_data reactants.data
pair_style reaxff NULL safezone 2.0 mincap 100
pair_coeff * * ffield.reax.cho C H O
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
fix charge all qeq/reaxff 1 0.0 10.0 1e-8 reaxff maxiter 500
thermo 1000
thermo_style custom step time atoms temp ke pe etotal press
thermo_modify lost error flush yes
min_style cg
minimize 1e-8 1e-6 2000 10000
reset_timestep 0
velocity all create 5500.0 49183 mom yes rot no dist gaussian
timestep 0.05
# Explicit ignition: warm internal modes before observing the isolated reactor.
fix ignition all nvt temp 5500.0 5500.0 10.0
run 20000
unfix ignition
reset_timestep 0
# No thermostat, rescaling, prescribed product coordinates or added heat after this point.
fix integrate all nve
fix species all reaxff/species 1 1 1000 species.out element C H O
run 0
