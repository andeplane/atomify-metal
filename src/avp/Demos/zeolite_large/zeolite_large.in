# Information about atoms for coloring and bonds
#/atom 1 silicon
#/atom 2 oxygen
#/bond 1 2 2.6

units metal
atom_style	atomic

read_data zeolite_zsm5.data
# 4 x 4 x 5 unit cells: 23,040 atoms, about 8 nm across, with the
# straight and zigzag channels running through the whole crystal.
replicate 4 4 5

pair_style	vashishta/table 10000 0.5
pair_coeff	* * SiO2.vashishta Si O
neigh_modify every 1 delay 0 check yes

mass 1 28.08
mass 2 15.9994

velocity all create 300 376847 loop geom

timestep 0.002

thermo_style one
thermo 100

fix nvt all nvt temp 300 300 1.0
run 1000000
