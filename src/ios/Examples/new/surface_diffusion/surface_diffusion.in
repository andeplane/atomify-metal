# Atoms hopping on a crystal surface: a Lennard-Jones fcc slab with a few
# extra atoms on top. The slab is held warm, and every now and then an extra
# atom gets enough energy from the vibrating surface to jump to the next
# hollow between the atoms below it. The orange lines are the paths they take.
#/atom 1 2.0 #7f9fc4
#/atom 2 2.0 #ff7a1a
log none
units		lj
dimension	3
boundary	p p f
atom_style	atomic

lattice		fcc 0.95
region		box block 0 8 0 8 -1 10
create_box	2 box
region		slab block INF INF INF INF 0 3.9
create_atoms	1 region slab
mass		* 1.0

# six extra atoms resting in hollows of the top layer
create_atoms	2 single 2.5 2.5 4.0 units lattice
create_atoms	2 single 5.5 1.5 4.0 units lattice
create_atoms	2 single 1.5 5.5 4.0 units lattice
create_atoms	2 single 6.5 6.5 4.0 units lattice
create_atoms	2 single 4.5 4.5 4.0 units lattice
create_atoms	2 single 7.5 3.5 4.0 units lattice

pair_style	lj/cut 2.5
pair_coeff	* * 1.0 1.0 2.5

# the two bottom layers are fixed, the rest is held at T = 0.4
region		bottom block INF INF INF INF 0 1.9
group		bottom region bottom
group		mobile subtract all bottom
velocity	bottom set 0.0 0.0 0.0
velocity	mobile create 0.4 12345 dist gaussian
fix		freeze bottom setforce 0.0 0.0 0.0
fix		1 mobile nvt temp 0.4 0.4 0.5

timestep	0.005
