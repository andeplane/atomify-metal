# Hydrogen and oxygen (2 H2 + O2 -> 2 H2O) with the ReaxFF force field.
# The gas starts hot enough to ignite. Nothing else is added: the energy
# the new O-H bonds release heats the gas further, which speeds the burning up.
#/atom 1 hydrogen
#/atom 3 oxygen
#/bond 1 3 1.4
#/bond 1 1 1.0
#/bond 3 3 1.7
log none
units		real
atom_style	charge
boundary	p p p

region		box block 0 18 0 12 0 12
create_box	3 box
mass		1 1.0080
mass		2 12.0107
mass		3 15.9994

molecule	h2 mol.H2
molecule	o2 mol.O2
create_atoms	0 random 36 4711 NULL mol h2 1234 overlap 2.2 maxtry 50000
create_atoms	0 random 18 4712 NULL mol o2 1235 overlap 2.2 maxtry 50000

pair_style	reaxff lmp_control
pair_coeff	* * ffield.reax.cho H C O
neighbor	2 bin
neigh_modify	every 1 delay 0 check yes

fix		1 all nve
fix		2 all qeq/reax 1 0.0 10.0 1e-4 param.qeq

# kinetic energy of each atom, which colors the atoms (hotter is brighter)
compute		ke all ke/atom

# relax the random placement, then heat the gas to 5000 K
minimize	1.0e-4 1.0e-6 100 1000
reset_timestep	0
velocity	all create 5000.0 4928459 rot yes dist gaussian

timestep	0.25
