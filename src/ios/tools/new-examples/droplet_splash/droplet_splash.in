# A liquid droplet falls onto a solid surface that it wets. It flattens into
# a pancake, a ring of liquid spreads out and rebounds, and the droplet
# settles on the surface. Lennard-Jones liquid, atoms colored by kinetic
# energy so the shock of the impact and the splash show.
log none
units		lj
dimension	3
boundary	p p f
atom_style	atomic

lattice		fcc 0.85
region		box block 0 14 0 14 -1 34
create_box	2 box
# the surface: three layers of type 2 below a few of type 2 that move
region		slab block INF INF INF INF 0 3.9
create_atoms	2 region slab
# the droplet, a ball of liquid above it (type 1), melted at the start
region		ball sphere 7 7 18 4.6
create_atoms	1 region ball
mass		* 1.0

pair_style	lj/cut 2.5
# liquid with itself, liquid with surface (attracts a bit more), surface with itself
pair_coeff	1 1 1.0 1.0 2.5
pair_coeff	1 2 1.2 1.0 2.5
pair_coeff	2 2 1.0 1.0 2.5

group		liquid type 1
group		surface type 2
region		bottom block INF INF INF INF 0 1.9
group		bottom region bottom
velocity	liquid create 0.7 4711 loop geom
velocity	liquid set NULL NULL -2.2 sum yes
velocity	bottom set 0.0 0.0 0.0

fix		1 all nve
fix		2 bottom setforce 0.0 0.0 0.0
# a heat bath in the middle of the surface keeps it at T = 0.5 and takes up the heat
region		bath block INF INF INF INF 1.9 3.9
group		bath region bath
fix		3 bath langevin 0.5 0.5 1.0 9876

# kinetic energy of each atom, which colors the atoms
compute		ke all ke/atom

thermo_modify	lost ignore
timestep	0.004
