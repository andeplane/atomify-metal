# A small cluster of atoms hits a crystal surface at high speed. The impact
# heats a spot of the crystal far above its melting point, throws atoms out
# and leaves a crater, and the heat spreads out as waves through the crystal.
# Atoms are colored by kinetic energy.
log none
units		lj
dimension	3
boundary	p p f
atom_style	atomic

lattice		fcc 1.0
region		box block 0 12 0 12 -1 26
create_box	2 box
region		slab block INF INF INF INF 0 8.9
create_atoms	1 region slab
# the cluster, a ball of 140 atoms or so above the surface
region		ball sphere 6 6 14 2.2
create_atoms	2 region ball
mass		* 1.0
pair_style	lj/cut 2.5
pair_coeff	* * 1.0 1.0 2.5

group		cluster type 2
region		bottom block INF INF INF INF 0 1.9
group		bottom region bottom
group		crystal type 1
velocity	crystal create 0.05 4711 dist gaussian
velocity	bottom set 0.0 0.0 0.0
velocity	cluster set 0.0 0.0 -5.5

fix		1 all nve
fix		2 bottom setforce 0.0 0.0 0.0
# a heat bath on the sides and the lower layers, so the heat leaves the box
# instead of building up
region		bath block INF INF INF INF 2 5.5
group		bath region bath
fix		3 bath langevin 0.05 0.05 0.5 9876

# kinetic energy of each atom, which colors the atoms
compute		ke all ke/atom

# atoms thrown far out of the box are dropped
thermo_modify	lost ignore

timestep	0.004
