# Small Lennard-Jones liquid for AtomifyKit tests.
suffix kk

#/atom 1 1.0 #ff0000
#/atom 2 1.5 #0000ff
#/bond 1 2 1.2
#/camera position 3.0 4.0 20.0
#/camera target 3.0 4.0 3.0

units lj
atom_style atomic
lattice fcc 0.8442
region box block 0 4 0 4 0 4
create_box 2 box
create_atoms 1 box
set type 1 type/fraction 2 0.5 12345
mass * 1.0
velocity all create 1.5 87287 loop geom

pair_style lj/cut 2.5
pair_coeff * * 1.0 1.0 2.5

include settings.lmp

compute ke all ke/atom
fix 1 all nve
thermo 50
run 200
