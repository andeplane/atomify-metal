# Small Lennard-Jones melt for the AtomifyEngine tests.
#/atom 1 argon
#/atom 2 1.2 #ff8800
#/bond 1 1 1.2
#/camera position 3.0 3.0 12.0
#/camera target 3.0 3.0 3.0

units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
mass            * 1.0
region          half block 0 2 INF INF INF INF
set             region half type 2
velocity        all create 3.0 87287 loop geom

# Relative to the working directory.
include         potential.lmp
neighbor        0.3 bin

fix             1 all nve
compute         msd all msd
compute         ke all ke/atom
variable        kinetic equal ke
thermo_style    custom step temp pe c_msd[4]
thermo          50
run             200
