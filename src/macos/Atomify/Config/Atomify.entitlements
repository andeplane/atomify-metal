<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store requires the App Sandbox. Atomify needs nothing more:
     simulations run in the app's own temporary folder, the examples are read
     from the bundle, and links open in the browser. No network, no files
     outside the container. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
